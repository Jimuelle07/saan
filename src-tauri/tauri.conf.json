{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "saan",
  "version": "0.1.0",
  "identifier": "dev.saan.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "saan",
        "width": 720,
        "height": 560,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Jimuelle Patron",
    "copyright": "Copyright © 2026 Jimuelle Patron",
    "shortDescription": "Private, local AI file search launcher",
    "longDescription": "saan is a privacy-first Windows file launcher with on-device semantic search, regex grep and glob matching.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
